<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script>
    // Applied before first paint so a saved theme choice doesn't flash the
    // system default for a frame. The toggle itself lives in nav.js.
    try {
      var t = localStorage.getItem("theme");
      if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
    } catch (e) {}
  </script>
  <title>cilippofilia.co.uk</title>
  <link rel="stylesheet" href="/styles.css" />
  <meta name="description" content="Filippo Cilia's hub for small, native SwiftUI apps — iOS, iPadOS, macOS, and watchOS." />
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
  <script src="https://cdn.jsdelivr.net/npm/animejs@3.2.2/lib/anime.min.js" defer></script>
</head>
<body>
  <div class="floating-icons" aria-hidden="true">
    <img class="floating-icon fi-1" src="/assets/app-icons/thumb/9tiles-icon.png" alt="" width="96" height="96" />
    <img class="floating-icon fi-2" src="/assets/app-icons/thumb/drinko-icon.png" alt="" width="76" height="76" />
    <img class="floating-icon fi-3" src="/assets/app-icons/thumb/iterly-icon.png" alt="" width="88" height="88" />
    <img class="floating-icon fi-4" src="/assets/app-icons/thumb/itsWritten-icon.png" alt="" width="80" height="80" />
    <img class="floating-icon fi-5" src="/assets/app-icons/thumb/relay-icon.png" alt="" width="92" height="92" />
  </div>
  <main>
    <div class="wrap">
      <section class="hero" style="margin-top:0">
        <div class="hero-grid">
          <div>
            <h1>Small yet powerful native apps — built with user experience in mind.</h1>
            <p class="lede">
              A hub for everything that ships out of this workspace — iOS, iPadOS, macOS, and
              watchOS apps, built with SwiftUI.
            </p>
            <div class="button-row">
              <a class="button" href="/app-store">See the App Store</a>
              <a class="button secondary" href="/style-guide">Style guide</a>
            </div>
          </div>
          <aside class="profile-card">
            <img class="profile-photo" src="/assets/profile.jpg" alt="Filippo Cilia" width="96" height="96" />
            <h3 class="profile-name">Filippo Cilia</h3>
            <p class="profile-role">Software Engineer, iOS</p>
            <p class="profile-location">Manchester, UK</p>
            <p class="profile-bio">Freelance iOS engineer. I build native Apple apps I'd actually want to use myself.</p>
            <div class="profile-social">
              <a href="https://github.com/cilippofilia" target="_blank" rel="noopener" aria-label="GitHub">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
              </a>
              <a href="https://www.linkedin.com/in/filippocarlocilia" target="_blank" rel="noopener" aria-label="LinkedIn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
              <a href="https://twitter.com/fcilia_dev" target="_blank" rel="noopener" aria-label="X">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href="https://instagram.com/cilippofilia" target="_blank" rel="noopener" aria-label="Instagram">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
            </div>
          </aside>
        </div>
      </section>

      <div class="featured" id="featured-strip" hidden></div>
    </div>
  </main>
  <script src="/nav.js"></script>
  <script>
    // Continuous idle drift for the floating app icons, via anime.js.
    // Each icon wanders to a fresh random point (with a small rotation)
    // every time it finishes a leg, so it keeps roaming around its
    // corner of the page rather than oscillating between two spots.
    document.addEventListener("DOMContentLoaded", () => {
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduceMotion || typeof anime !== "function") return;

      document.querySelectorAll(".floating-icon").forEach((el, i) => {
        const wander = () => {
          anime({
            targets: el,
            translateX: () => anime.random(-22, 22),
            translateY: () => anime.random(-20, 20),
            rotate: () => anime.random(-10, 10),
            duration: () => anime.random(6000, 10000),
            easing: "easeInOutSine",
            complete: wander,
          });
        };
        setTimeout(wander, i * 300);
      });
    });
  </script>
  <script>
    // Highlight whichever published app is still a preorder, if any —
    // computed live from the same feed the App Store page uses, never hardcoded.
    fetch("/api/appstore-apps")
      .then((r) => r.json())
      .then((apps) => {
        const upcoming = apps.find((a) => a.releaseDate && new Date(a.releaseDate) > new Date());
        if (!upcoming) return;
        const strip = document.getElementById("featured-strip");
        const fmtDate = (iso) =>
          new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
        strip.innerHTML = `
          ${
            upcoming.icon
              ? `<img class="featured-icon" src="${upcoming.icon}" alt="" width="64" height="64" />`
              : ""
          }
          <div class="featured-body">
            <span class="featured-eyebrow">Preorder</span>
            <h3>${upcoming.name}</h3>
            <p>${upcoming.tagline || ""} Releases ${fmtDate(upcoming.releaseDate)}.</p>
          </div>
          <a class="button secondary" href="${upcoming.localUrl || upcoming.url}">Preorder ›</a>
        `;
        strip.hidden = false;
      })
      .catch(() => {});
  </script>
</body>
</html>
